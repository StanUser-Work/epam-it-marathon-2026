# Deployed application under test
FRONTEND_URL=https://<distribution-id>.cloudfront.net
API_BASE_URL=https://<api-id>.execute-api.eu-central-1.amazonaws.com/develop

# Location with tables and dishes (see infra/seed/seed_demo_data.py — prints LOCATION_ID)
LOCATION_ID=

# Waiter assigned to LOCATION_ID (created by the seed script). Quote passwords that contain #: WAITER_PASSWORD='...'
WAITER_EMAIL=
WAITER_PASSWORD=

# Optional: password for customers the tests register (8-16 chars, upper, lower, digit, symbol)
TEST_USER_PASSWORD=

# Optional: parallel workers (default 3)
WORKERS=

# Optional ⭐ Report Portal
RP_ENDPOINT=
RP_PROJECT=
RP_API_KEY=
RP_LAUNCH=
