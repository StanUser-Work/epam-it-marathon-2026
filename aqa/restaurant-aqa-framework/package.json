{
  "name": "restaurant-aqa-framework",
  "version": "2.0.0",
  "description": "E2E (UI + API) tests of the deployed Group Pre-Order feature, levels 1-3",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:l1": "playwright test --grep @level1",
    "test:l2": "playwright test --grep @level2",
    "test:l3": "playwright test --grep @level3",
    "test:ui": "playwright test --grep @ui",
    "test:api": "playwright test --grep @api",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@reportportal/agent-js-playwright": "^5.1.11",
    "@types/node": "^22.0.0",
    "dotenv": "^17.2.0",
    "typescript": "^5.6.0"
  }
}
